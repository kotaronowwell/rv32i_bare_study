{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "build",

            "type": "shell",

            "command": "cmake --build build",

            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "qemu-gdb",

            "type": "shell",

            "command": "pkill -x qemu-system-riscv32 2>/dev/null || true; nohup qemu-system-riscv32 -machine virt -bios none -kernel build/hello -nographic -S -gdb tcp::1234 >/tmp/rv32i_bare_study_qemu.log 2>&1 &",

            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },

            "problemMatcher": []
        },
        {
            "label": "stop-qemu-gdb",

            "type": "shell",

            "command": "pkill -x qemu-system-riscv32 2>/dev/null || true",

            "problemMatcher": []
        }
    ]
}